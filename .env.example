# ===== Acesso ao sistema =====
ADMIN_EMAIL=voce@seudominio.com
ADMIN_PASSWORD=troque-esta-senha
# gere com: openssl rand -hex 32
AUTH_SECRET=
# true quando estiver atrás de HTTPS (Caddy)
COOKIE_SECURE=true

# ===== Domínio (Caddy gera o certificado HTTPS sozinho) =====
# aponte um registro A do domínio para o IP da VPS antes de subir
DOMAIN=prospec.seudominio.com

# ===== Banco =====
POSTGRES_PASSWORD=troque-esta-senha-do-banco

# ===== WhatsApp (WAHA) =====
# gere com: openssl rand -hex 24
WAHA_API_KEY=
# WEBJS (padrão, mais compatível) | NOWEB | GOWS (mais leves em RAM)
WAHA_ENGINE=WEBJS
# gere com: openssl rand -hex 24 — protege o webhook que recebe as mensagens
WEBHOOK_SECRET=

# ===== Chaves (também podem ser preenchidas pela tela Configurações) =====
OPENAI_API_KEY=
APIFY_TOKEN=
GOOGLE_PLACES_KEY=

TZ=America/Sao_Paulo
